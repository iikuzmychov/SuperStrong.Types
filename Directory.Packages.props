<Project>
  
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  
  <!-- Hot Chocolate -->
  <PropertyGroup>
    <_HotChocolateVersion>[16.0.0,17.0.0)</_HotChocolateVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="HotChocolate" Version="$(_HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Types" Version="$(_HotChocolateVersion)" />
  </ItemGroup>
    
  <!-- ASP.NET Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.0,11.0.0)" />
    <PackageVersion Include="Microsoft.OpenApi" Version="[2.9.0,3.0.0)" />
  </ItemGroup>

  <!-- EF Core -->
  <PropertyGroup>
    <_EntityFrameworkCoreVersion>[10.0.0,11.0.0)</_EntityFrameworkCoreVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(_EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(_EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(_EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(_EntityFrameworkCoreVersion)" />
    
    <!--
      Microsoft.EntityFrameworkCore.SqlServer 10.x.x depends on vulnerable version 
      of System.Security.Cryptography.Pkcs 9.x.x, so its version is explicitly pinned
      to the lowest non-vulnerable one
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
  
  <!-- Newtonsoft.Json -->
  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="[13.0.2,14.0.0)" />
  </ItemGroup>
  
  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Meziantou.Polyfill" Version="1.0.166" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Verify.XunitV3" Version="31.19.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
  
</Project>
